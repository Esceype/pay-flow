# Copy to .env and fill in. .env is gitignored (see .gitignore: "env files").

# --- Database & cache ---
# For local `npm run dev` / `npx prisma migrate dev` (outside Docker) point
# these at localhost; Docker Compose overrides both to the in-network
# hostnames (postgres/redis) for the app/worker containers — see
# docker-compose.yml. Postgres is published on host port 5433, not 5432:
# if you also have a native/local Postgres install, it likely already owns
# 5432, and two processes can end up listening on the same Windows port
# with no error — your client then connects to whichever one wins port
# arbitration, silently, which reads as "wrong password" against the one
# you didn't mean to hit. 5433 sidesteps that entirely.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/payflow?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Stripe: platform-level API key ---
# Used for platform-level operations only (Connect OAuth token exchange,
# reading platform account info). NOT scoped to any single tenant — never
# used to act on a connected account's behalf (that always passes
# `{ stripeAccount: user.stripeAccountId }` explicitly).
STRIPE_SECRET_KEY="sk_test_..."

# --- Stripe: Standard Connect OAuth ---
# From your Stripe Dashboard -> Connect settings -> Integration. The OAuth
# redirect URI Stripe redirects back to (NEXTAUTH_URL + /api/connect/callback,
# e.g. http://localhost:3000/api/connect/callback for local dev) must be
# registered there too, or the callback will fail.
STRIPE_CONNECT_CLIENT_ID="ca_..."

# --- Stripe webhook secret ---
# Signing secret of the single webhook endpoint, /api/webhooks/stripe-connect,
# registered with scope "Connected accounts" (connect: true). It receives
# every event from connected accounts — account.updated and
# account.application.deauthorized included — and all of them go through
# the transactional outbox + BullMQ pipeline. See
# docs/adr/003-stripe-connect-multitenancy.md (amendment) and
# docs/adr/001-outbox-pattern.md. For local dev, `stripe listen
# --forward-connect-to localhost:3000/api/webhooks/stripe-connect` prints it.
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# --- Platform fee ---
# Taken from every invoice payment via application_fee_amount on the direct
# charge, in basis points (250 = 2.5%). 0 or unset = no fee. See ADR-006.
PLATFORM_FEE_BPS=250

# --- Auth (required — Phase 1) ---
# NEXTAUTH_SECRET signs session JWTs (Credentials provider only — no OAuth
# providers, so no NextAuth Account/Session/VerificationToken tables).
# Generate a real one with: openssl rand -base64 32
# NEXTAUTH_URL is also reused as the base URL for the Stripe Connect
# redirect_uri (src/lib/stripe-connect.ts) — keep it accurate if you're not
# on localhost:3000.
NEXTAUTH_SECRET="replace-with-a-real-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (optional) ---
# Notifications to tenants (payment received, subscription payment failed)
# are sent through Resend. Without a real key — unset, empty, or this
# placeholder — nothing is sent: each notification is recorded as SKIPPED
# and logged instead, so everything else runs unchanged. See ADR-010.
RESEND_API_KEY="re_..."
# The From address. Resend's onboarding@resend.dev works without verifying
# a domain, but only delivers to the address the Resend account belongs to.
EMAIL_FROM="PayFlow <onboarding@resend.dev>"

# --- Webhook endpoint ---
# How long the endpoint waits for Redis before answering Stripe anyway. By
# then the event is stored in Postgres, and the worker's relay enqueues
# whatever wasn't. See the amendment to ADR-001.
WEBHOOK_ENQUEUE_TIMEOUT_MS=2000

# --- Worker admin server ---
# The worker serves two operator pages on its own port, both behind HTTP
# Basic Auth (src/worker/server.ts): Bull Board at /admin/queues and the
# webhook event / dead-letter page at /admin/events. The worker refuses to
# start without both of these set, on purpose.
BULL_BOARD_USER="admin"
BULL_BOARD_PASSWORD="change-me"
WORKER_HTTP_PORT=3001
WORKER_CONCURRENCY=5
