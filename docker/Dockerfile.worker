FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
# devDependencies are kept (no --omit=dev): the worker runs TypeScript
# directly via tsx rather than a separate compile step. Simpler, at the cost
# of a larger image and a little startup time; compiling with tsc (+
# tsc-alias for path aliases) and --omit=dev is the deferred optimization.
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
EXPOSE 3001
CMD ["npx", "tsx", "src/worker/index.ts"]
