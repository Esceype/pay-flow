// PayFlow — Prisma schema
//
// Multi-tenant model: `User` is a tenant (business owner) who connects their
// own Stripe account via Stripe Connect (Standard accounts). `Customer` is
// that tenant's own end customer, never a platform-level concept.
//
// Partitioning note (see docs/adr, "partition-ready schema"): `Transaction`
// is the highest-volume table and is designed to eventually be physically
// partitioned with `PARTITION BY RANGE (createdAt)`. We are NOT doing that
// yet (no real data volume justifies it). If/when we do, Postgres requires
// the partition key to be part of every unique constraint, which means the
// primary key would need to become composite (id, createdAt) at that point
// — noted here so it isn't a surprise during that migration.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer allows
// datasource.url in the schema itself), consumed there via a driver
// adapter — see src/lib/prisma.ts for the PrismaClient side of this.
datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  // Credentials auth (Auth.js, JWT sessions — see src/lib/auth.ts). Null is
  // possible in principle for a future OAuth-only sign-in method; today
  // every User has one since Credentials is the only provider.
  hashedPassword String?

  // Stripe Connect (Standard account). Both are null until the tenant starts
  // onboarding; onboardingComplete flips to true only once Stripe confirms
  // the account can accept charges (see account.updated handling, ADR-003).
  // @unique already creates the index the Connect webhook's tenant lookup
  // needs — no separate @@index on top of it.
  stripeAccountId    String? @unique
  onboardingComplete Boolean @default(false)

  // When the current stripeAccountId was linked (OAuth callback). Ordering
  // guard for account.application.deauthorized: a queued deauthorization
  // whose event.created predates this is stale (the tenant has since
  // reconnected) and must not unlink the fresh connection. ADR-003.
  stripeConnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers     Customer[]
  invoices      Invoice[]
  subscriptions Subscription[]
  transactions  Transaction[]
  webhookEvents WebhookEvent[]
  revenueStats  MaterializedRevenueStats?
}

model Customer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe Customer object id, scoped to the tenant's connected account.
  stripeCustomerId String? @unique
  email            String
  name             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices      Invoice[]
  subscriptions Subscription[]

  // One customer per email per tenant. Unique (not just an index) so a
  // double-submitted "add customer" form fails on the constraint instead of
  // creating a twin. The unique index also serves the (userId, email)
  // lookup the plain index used to.
  @@unique([userId, email])
}

enum InvoiceStatus {
  PENDING // awaiting payment (includes async methods still settling)
  PAID
  FAILED // async payment method failed after checkout completed
  EXPIRED // Checkout Session expired unpaid — a new link can be generated
  VOID
}

model Invoice {
  id         String   @id @default(cuid())
  // Restrict, not Cascade: a customer with invoices cannot be deleted —
  // billing history must never disappear as a side effect. The app checks
  // this first for a friendly error; the FK is the backstop.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Denormalized tenant id (same reasoning as Transaction.userId): the
  // invoice list is "this tenant's invoices, newest first", which should
  // not need a join through Customer.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency key for the create-invoice request itself: rendered into
  // the form as a hidden field, so a double-submit hits this unique
  // constraint instead of creating a second invoice. ADR-006.
  requestKey String @unique

  // Not used: invoices are our own records backed by a one-time Checkout
  // Session, not Stripe Invoice objects (ADR-006). Kept for a possible
  // future move to Stripe Invoicing.
  stripeInvoiceId         String? @unique
  // Null only briefly (intent-first: the row is written before the session
  // exists) or if session creation failed — "Get payment link" retries it.
  stripeCheckoutSessionId String? @unique

  status    InvoiceStatus @default(PENDING)
  amountDue Int // cents
  currency  String        @default("usd")
  // Platform fee (cents) taken from this payment via application_fee_amount
  // on the direct charge. Snapshotted at creation so a later fee-rate change
  // never rewrites what an existing invoice charged.
  applicationFeeAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  // Real query pattern: "this customer's invoices in status X" (e.g. the
  // has-invoices check before deleting a customer). Composite over separate
  // indexes because Postgres serves "WHERE customerId = ? AND status = ?"
  // from one btree scan instead of intersecting two.
  @@index([customerId, status])
  // Tenant invoice list, newest first — one index scan, no sort.
  @@index([userId, createdAt])
}

enum SubscriptionStatus {
  // Ours, not Stripe's: the row exists (intent-first) but the customer
  // hasn't completed Checkout, so there is no Stripe subscription yet.
  AWAITING_CHECKOUT
  // The rest mirror Stripe's subscription.status one to one.
  INCOMPLETE
  INCOMPLETE_EXPIRED // terminal: first payment never succeeded
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELED // terminal
}

// Mirrors Stripe's price.recurring.interval. PayFlow itself only creates
// MONTH and YEAR; DAY and WEEK exist so a subscription edited in the
// tenant's Stripe Dashboard can still be mirrored instead of failing.
enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

model Subscription {
  id         String   @id @default(cuid())
  customerId String
  // Restrict for the same reason as Invoice.customer.
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Denormalized tenant id (same reasoning as Transaction.userId): the
  // subscription list and the MRR read model are both per tenant.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency key of the create request, as on Invoice. ADR-006.
  requestKey String @unique

  // Null until Stripe creates the subscription, which only happens once
  // the customer completes Checkout. Set by the worker from the first
  // lifecycle event that carries our row id in its metadata. ADR-007.
  stripeSubscriptionId    String? @unique
  // The Checkout Session (mode: subscription) the customer subscribes
  // through. Null only briefly, or if creating it failed (retryable).
  stripeCheckoutSessionId String? @unique

  status SubscriptionStatus @default(AWAITING_CHECKOUT)

  // What is charged per billing period (unit amount × quantity), in cents.
  // Written at creation and re-synced from every lifecycle event, since
  // the tenant can change the price in their own Stripe Dashboard. These
  // four fields are what the MRR read model (Phase 5) is computed from.
  amount        Int
  currency      String
  interval      BillingInterval
  intervalCount Int             @default(1)

  // Platform fee in basis points (application_fee_percent on the Stripe
  // subscription), snapshotted at creation like Invoice.applicationFeeAmount.
  applicationFeeBps Int @default(0)

  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  // Stripe's `event.created` timestamp of the last lifecycle event actually
  // applied to this row. BullMQ does not guarantee processing order across
  // concurrent jobs, so the worker compares an incoming event's timestamp
  // against this before writing — stale (out-of-order) events are discarded
  // instead of applied. Last-write-wins by event time, not processing time.
  // ADR-007 covers the cases a timestamp alone can't decide.
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([customerId])
  // "This tenant's subscriptions in status X": the subscription list, and
  // the MRR recomputation over a tenant's active subscriptions (Phase 5).
  @@index([userId, status])
}

model Transaction {
  id     String @id @default(cuid())
  // Denormalized tenant id (rather than requiring a join through Invoice ->
  // Customer -> User) because the dominant query is "this tenant's
  // transaction history", and that must stay fast as this table grows.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What the money was for: a one-time Invoice, or a billing period of a
  // Subscription (a Stripe subscription invoice is recorded as a
  // Transaction against the Subscription, never as one of our Invoice
  // rows — ADR-007). At most one of the two is set.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Originating Stripe event, kept for traceability/correlation — not a
  // uniqueness/idempotency guard by itself (that's WebhookEvent.stripeEventId).
  // Deliberately not @unique: a partitioned table can only enforce
  // uniqueness on keys that include the partition key (createdAt), so
  // duplicate protection is done at write time instead — see ADR-007.
  stripeEventId String?

  // Free-form Stripe event type (e.g. "charge.succeeded", "charge.refunded")
  // rather than a rigid enum: Stripe adds event types over time and we don't
  // want a migration every time we start handling a new one.
  type String

  amount   Int // cents; positive = inflow, negative = refund/reversal
  currency String @default("usd")

  createdAt DateTime @default(now())

  // The actual query this serves: paginate a tenant's transaction history by
  // recency ("WHERE userId = ? ORDER BY createdAt DESC LIMIT ?"). One
  // composite (userId, createdAt) index serves that in a single index scan;
  // two single-column indexes would force Postgres to intersect bitmaps
  // instead, which loses to the composite past a small row count.
  @@index([userId, createdAt])
}

enum WebhookEventStatus {
  // Outbox row inserted; the BullMQ job is enqueued right after as a
  // separate, idempotent step — not in the same transaction (ADR-001).
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id String @id @default(cuid())

  // Stripe's event.id — the inbound idempotency guard. Globally unique
  // across the platform and every connected account.
  stripeEventId String @unique

  // The connected account the event came from (`event.account`). Every
  // event this project consumes is Connected-accounts scoped, including
  // account.updated (ADR-003) — null only for a misrouted event without an
  // `account` field.
  stripeAccountId String?

  // Resolved tenant. Nullable because resolution can fail (unrecognized
  // account) — we still persist the raw event for audit/debugging rather
  // than silently dropping it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type    String // Stripe event type, e.g. "checkout.session.completed"
  payload Json // raw event payload, for replay/debugging

  // Every event goes through the outbox + BullMQ pipeline, account.updated
  // included (ADR-003, amended).
  status WebhookEventStatus @default(RECEIVED)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([userId, receivedAt])
  @@index([status])
}

model MaterializedRevenueStats {
  // Read model for the analytics dashboard (simplified CQRS: Transaction is
  // the write model, this is the read model). One row per tenant, updated
  // asynchronously by the worker after each processed transaction, and
  // cached in Redis with TTL + explicit invalidation on top of this table.
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mrr          Int   @default(0) // cents
  churnRate    Float @default(0)
  totalRevenue Int   @default(0) // cents, lifetime

  updatedAt DateTime @updatedAt
}
